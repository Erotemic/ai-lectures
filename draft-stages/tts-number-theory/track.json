{
  "id": "number-theory",
  "title": "Number Theory from First Principles",
  "summary": "A proof-driven introduction to number theory: divisibility, modular arithmetic, integer equations, continued fractions and the complete Pell theorem, quadratic reciprocity, Möbius inversion, elementary prime distribution, Hensel lifting, Gaussian integer factorization and two squares, primality certification, and finite fields with primitive roots.",
  "assumed_background": [
    "integer arithmetic, fractions, equations and basic algebra",
    "comfortable reading simple proofs helps; the Mathematical Reasoning and Proof course is optional preparation",
    "no group theory, field theory or analytic number theory assumed"
  ],
