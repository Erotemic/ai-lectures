{
  "id": "number-theory",
  "title": "Number Theory from First Principles",
  "summary": "A proof-driven introduction to number theory, from Euclid, congruences, quadratic reciprocity, Pell equations, Gaussian integers, and finite fields through analytic tools, Dirichlet’s theorem and Chebyshev bounds, with exact two-square representation counts, lattice points, and finite-field extension theory.",
  "assumed_background": [
    "integer arithmetic, fractions, equations and basic algebra",
    "comfortable reading simple proofs helps; the Mathematical Reasoning and Proof course is optional preparation",
    "no group theory, field theory or analytic number theory assumed"
  ],
