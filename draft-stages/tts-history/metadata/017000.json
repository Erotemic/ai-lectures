  "historical_claims": [
    {
      "id": "017000-h01",
      "anchor": "Marvin Rosenblum was born in Brooklyn, New York, in nineteen twenty-six.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-ias-community"
      ],
      "source_locator": "IAS Community of Scholars entry",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h02",
      "anchor": "His early university training included a bachelor of science in electrical engineering.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-uva-board"
      ],
      "source_locator": "UVA Board of Visitors Nov 2010 p.3",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h03",
      "anchor": "He went on to the University of California at Berkeley, earning advanced degrees in mathematics, including his doctorate in nineteen fifty-five.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-ias-community",
        "history-rosenblum-uva-board"
      ],
      "source_locator": "IAS record; UVA Board p.3",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h04",
      "anchor": "The subject of his Berkeley thesis was the perturbation of continuous spectra.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-thesis"
      ],
      "source_locator": "1955 thesis bibliographic record",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h05",
      "anchor": "His doctoral adviser was František Wolf.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-simon"
      ],
      "source_locator": "Simon §13 p.24",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h06",
      "anchor": "Rosenblum submitted his thesis in March nineteen fifty-five.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-simon"
      ],
      "source_locator": "Simon §13 p.24",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h07",
      "anchor": "A Berkeley technical report circulated in December of that year, before the result appeared in a journal.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-simon"
      ],
      "source_locator": "Simon §13 pp.24–25",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h08",
      "anchor": "In nineteen fifty-five Rosenblum joined the University of Virginia as an assistant professor.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-uva-board"
      ],
      "source_locator": "UVA Board p.3",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h09",
      "anchor": "He was a member of the Institute for Advanced Study in Princeton from September nineteen fifty-nine to August nineteen sixty,",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-bio"
      ],
      "source_locator": "IAS membership dates",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h10",
      "anchor": "Rosenblum's early work established a special case for operators with purely absolutely continuous spectrum.",
      "kind": "historical_mathematical_work",
      "source_ids": [
        "history-rosenblum-simon",
        "history-rosenblum-1957"
      ],
      "source_locator": "Simon §13 p.24; original 1957 paper",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h11",
      "anchor": "Kato proved the general trace-class version in nineteen fifty-seven.",
      "kind": "historical_mathematical_work",
      "source_ids": [
        "history-rosenblum-simon"
      ],
      "source_locator": "Simon §13 pp.24–25",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h12",
      "anchor": "Kato later referred to Rosenblum's work and acknowledged receiving a technical report.",
      "kind": "historical_relationship",
      "source_ids": [
        "history-rosenblum-simon"
      ],
      "source_locator": "Simon §13 p.25",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h13",
      "anchor": "In his nineteen fifty-six Duke Mathematical Journal paper, Rosenblum approached the equation B X minus X A equals Q in the setting of bounded operators.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-primary",
        "history-rosenblum-1969"
      ],
      "source_locator": "Duke Math J 23 (1956) 263–269; 1969 §1",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h14",
      "anchor": "In nineteen fifty-eight Rosenblum published a notably economical proof of this fact.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-1958",
        "history-rosenblum-fuglede-proof"
      ],
      "source_locator": "JLMS 33 (1958) 376–377",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h15",
      "anchor": "In nineteen sixty-nine Rosenblum returned to the operator equation with self-adjoint A and B that could be unbounded.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-1969"
      ],
      "source_locator": "Proc AMS 20 (1969) 115–120",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h16",
      "anchor": "His nineteen sixty paper, The Absolute Continuity of Toeplitz's Matrices, investigated this question for a broad class of real symbols.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-toeplitz-1960"
      ],
      "source_locator": "Pacific J Math 10 (1960) 987–996",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h17",
      "anchor": "Later papers in the nineteen sixties developed concrete spectral analysis for self-adjoint Toeplitz operators.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-toeplitz-modern"
      ],
      "source_locator": "Sobolev–Yafaev review; 1963 and 1965 references",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h18",
      "anchor": "With James Rovnyak he wrote Hardy Classes and Operator Theory, published in nineteen eighty-five.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-hardy-1985"
      ],
      "source_locator": "Oxford 1985 WorldCat",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h19",
      "anchor": "Rosenblum and Rovnyak later published Topics in Hardy Classes and Univalent Functions in nineteen ninety-four.",
      "kind": "historical_publication",
      "source_ids": [
        "history-rosenblum-hardy-1994"
      ],
      "source_locator": "Springer 1994 Google Books record",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h20",
      "anchor": "He chaired its mathematics department from nineteen sixty-nine to nineteen seventy-three and became Commonwealth Professor in nineteen seventy-eight.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-uva-board"
      ],
      "source_locator": "UVA Board 2010 p.3",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h21",
      "anchor": "University records credit him with directing eighteen doctoral dissertations.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-uva-board"
      ],
      "source_locator": "UVA Board 2010 p.2",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h22",
      "anchor": "He was also an editor of Integral Equations and Operator Theory,",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-uva-board",
        "history-rosenblum-uva-news"
      ],
      "source_locator": "UVA Board p.2; UVA Today 2011",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h23",
      "anchor": "A former student described him as fair, gracious, intelligent, and good-humored.",
      "kind": "historical_recollection",
      "source_ids": [
        "history-rosenblum-uva-board"
      ],
      "source_locator": "UVA Board 2010 p.2, lightly paraphrased",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h24",
      "anchor": "He retired from Virginia in May two thousand and died in two thousand three.",
      "kind": "historical_biography",
      "source_ids": [
        "history-rosenblum-uva-news",
        "history-rosenblum-uva-board"
      ],
      "source_locator": "UVA Today 2011; UVA Board pp.2–3",
      "audit_status": "source_cross_checked"
    },
    {
      "id": "017000-h25",
      "anchor": "The University approved a professorship in his name in twenty ten. A gift from his son Mendel Rosenblum and Mendel's wife, Diane Greene, supported the endowment, and the university announced it publicly in twenty eleven.",
      "kind": "historical_institutional_record",
      "source_ids": [
        "history-rosenblum-uva-board",
        "history-rosenblum-uva-news"
      ],
      "source_locator": "Nov 2010 Board approval; April 2011 news announcement",
      "audit_status": "source_cross_checked"
    }
  ]
}
