    "Mathematics",
    "Computer Science"
  ],
  "assumed_background": [
    "basic graph and finite-set vocabulary",
    "elementary programming and proof by induction; specialized matching and Dyck-word prerequisites taught in this pack",
    "Lean and source verification background available as optional cross-links"
