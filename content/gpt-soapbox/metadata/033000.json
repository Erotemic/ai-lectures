  "historical_claims": [
    {
      "id": "m033-h01",
      "anchor": "In the 1860s, growers in the southern Rhône region of France noticed an alarming decline.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review",
        "gs-vines-genetics-2019"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h02",
      "anchor": "In 1868, the botanist Jules-Émile Planchon examined affected vines near the Rhône and reported tiny insects on their roots.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review",
        "gs-vines-entomology-2007"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h03",
      "anchor": "Its adult root-feeding forms are about a millimeter long or smaller.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-ucipm-home"
      ],
      "source_locator": "gs-vines-ucipm-home",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h04",
      "anchor": "Work by Planchon and his French colleagues, along with the American entomologist Charles Valentine Riley, helped establish that forms seen on grape leaves in North America and forms on damaged roots in France belonged to the same insect species.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-entomology-2007",
        "gs-vines-ncstate"
      ],
      "source_locator": "gs-vines-entomology-2007",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h05",
      "anchor": "Phylloxera originated in North America.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-genetics-2019",
        "gs-vines-napa-chapter"
      ],
      "source_locator": "gs-vines-genetics-2019",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h06",
      "anchor": "Phylloxera is widely understood to have crossed the ocean on infested planting material, although the exact route of its first introduction cannot be reconstructed with certainty.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-genetics-2019",
        "gs-vines-cambridge-review"
      ],
      "source_locator": "gs-vines-genetics-2019",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h07",
      "anchor": "Carbon disulfide could be injected into the soil to kill the insect.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h08",
      "anchor": "In 1881, a phylloxera congress in Bordeaux discussed grafting European vines onto resistant American roots as a durable approach.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h09",
      "anchor": "The French High Commission on phylloxera formally endorsed it in 1888.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h10",
      "anchor": "In 1887, the French botanist Pierre Viala traveled through parts of the United States to seek grape species adapted to conditions resembling those of French vineyards.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h11",
      "anchor": "In Denison, Texas, he met the horticulturist Thomas Volney Munson.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review",
        "gs-vines-munson"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h12",
      "anchor": "One of them, *Vitis berlandieri*, grew among the limestone of central Texas.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-vitis-2020",
        "gs-vines-oklahoma"
      ],
      "source_locator": "gs-vines-vitis-2020",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h13",
      "anchor": "When French production fell, imports from Spain and Italy increased.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h14",
      "anchor": "French colonial production in North Africa expanded as wine markets shifted.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-cambridge-review"
      ],
      "source_locator": "gs-vines-cambridge-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h15",
      "anchor": "In 1983, investigators found phylloxera feeding on AxR1 roots in Napa Valley.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-napa-chapter",
        "gs-vines-california-1996"
      ],
      "source_locator": "gs-vines-napa-chapter",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m033-h16",
      "anchor": "By the end of 1995, more than twelve thousand acres in Napa and Sonoma had been removed as a direct result of the outbreak, according to research published by University of California scientists.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-vines-california-1996"
      ],
      "source_locator": "gs-vines-california-1996",
      "audit_status": "source_passage_checked"
    }
  ],
  "claim_evidence": [
    {
      "id": "m033-c01",
      "anchor": "Grafting and crossing are different operations.",
      "source_ids": [
        "gs-vines-grafting-2022",
        "gs-vines-grapebotany"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-vines-grafting-2022",
      "evidence_detail": "Graft union joins separate plant tissues with new vascular connections; the two genotypes are not merged by sexual recombination."
    },
    {
      "id": "m033-c02",
      "anchor": "A rootstock is living tissue with its own responses to drought, salts, soil chemistry, insects, and disease.",
      "source_ids": [
        "gs-vines-vitis-2020",
        "gs-vines-oklahoma"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-vines-vitis-2020",
      "evidence_detail": "Rootstocks vary in environmental tolerance, growth habit and pest resistance."
    },
    {
      "id": "m033-c03",
      "anchor": "The insect has not been banished from the world. Growers are cultivating plants that can survive alongside it.",
      "source_ids": [
        "gs-vines-ucipm",
        "gs-vines-ucipm-home"
      ],
      "provenance": "author_synthesis_from_sources",
      "source_locator": "gs-vines-ucipm",
      "evidence_detail": "Management guidance focuses on rootstock resistance rather than global eradication of phylloxera."
    }
  ]
}
