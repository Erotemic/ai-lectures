      "id": "m031-c03",
      "anchor": "A visual resemblance between signs is not proof of a shared value.",
      "source_ids": [
        "gs-linearb-cambridge-process"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-linearb-cambridge-process",
      "evidence_detail": "Reason to treat Cypriot script parallels as working hypotheses rather than conclusive evidence."
    },
    {
