  "historical_claims": [
    {
      "id": "m031-h01",
      "anchor": "In the spring of 1953, a letter arrived in London from an archaeological excavation in Greece.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-chadwick-blegen"
      ],
      "source_locator": "gs-linearb-chadwick-blegen",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h02",
      "anchor": "Applying Ventris's proposed values to the signs, Blegen found something astonishing.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-chadwick-blegen"
      ],
      "source_locator": "gs-linearb-chadwick-blegen",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h03",
      "anchor": "The Greek word tripodes means tripods.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-chadwick-blegen"
      ],
      "source_locator": "gs-linearb-chadwick-blegen",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h04",
      "anchor": "The people who wrote in Linear B lived in the late Bronze Age, more than three thousand years ago.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-oxford-nakassis"
      ],
      "source_locator": "gs-linearb-oxford-nakassis",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h05",
      "anchor": "Clay tablets that had not been deliberately fired sometimes became harder when the buildings around them burned.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-oxford-colvin"
      ],
      "source_locator": "gs-linearb-oxford-colvin",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h06",
      "anchor": "In 1900, the archaeologist Arthur Evans began extensive excavation at Knossos on Crete.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-process"
      ],
      "source_locator": "gs-linearb-cambridge-process",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h07",
      "anchor": "A Greek antiquarian named Minos Kalokairinos had excavated parts of the site earlier, in 1878.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-process"
      ],
      "source_locator": "gs-linearb-cambridge-process",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h08",
      "anchor": "Evans distinguished three writing systems: Cretan Hieroglyphic, Linear A, and Linear B.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-process"
      ],
      "source_locator": "gs-linearb-cambridge-process",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h09",
      "anchor": "Evans died in 1941 before the principal collection of Knossos tablets had appeared in a usable form.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-process"
      ],
      "source_locator": "gs-linearb-cambridge-process",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h10",
      "anchor": "New tablets found at Pylos in 1939 opened another enormous body of evidence, but the Second World War interrupted excavation and publication.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-process"
      ],
      "source_locator": "gs-linearb-cambridge-process",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h11",
      "anchor": "Alice Kober taught classics at Brooklyn College in New York.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-process",
        "gs-linearb-kober-archive"
      ],
      "source_locator": "gs-linearb-cambridge-process",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h12",
      "anchor": "Her surviving papers include thousands of small slips of paper arranged in reused cigarette cartons.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-kober-archive"
      ],
      "source_locator": "gs-linearb-kober-archive",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h13",
      "anchor": "She died in 1950, at forty-three, before the breakthrough.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-aja-timeline",
        "gs-linearb-kober-archive"
      ],
      "source_locator": "gs-linearb-aja-timeline",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h14",
      "anchor": "Bennett studied the shapes of the Linear B characters, separating distinct signs from variants made by different hands.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-process"
      ],
      "source_locator": "gs-linearb-cambridge-process",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h15",
      "anchor": "In 1936, as a schoolboy, he attended an exhibition about Greek archaeology and encountered Evans and the Knossos finds.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-ventris"
      ],
      "source_locator": "gs-linearb-cambridge-ventris",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h16",
      "anchor": "On June 1, 1952, he circulated a work note titled Are the Knossos and Pylos tablets written in Greek?",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-ventris"
      ],
      "source_locator": "gs-linearb-cambridge-ventris",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h17",
      "anchor": "He announced the result on the BBC in July.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-ventris"
      ],
      "source_locator": "gs-linearb-cambridge-ventris",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h18",
      "anchor": "Ventris and Chadwick worked together, publishing a scholarly account in 1953 and eventually a large joint study of the tablets.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-cambridge-intro"
      ],
      "source_locator": "gs-linearb-cambridge-intro",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h19",
      "anchor": "In the spring of 1953, Blegen was preparing previously unpublished tablets from Pylos.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-chadwick-blegen"
      ],
      "source_locator": "gs-linearb-chadwick-blegen",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h20",
      "anchor": "Take an administrative tablet in the Heraklion Archaeological Museum.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-heraklion-page"
      ],
      "source_locator": "gs-linearb-heraklion-page",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m031-h21",
      "anchor": "Linear A remains undeciphered in the sense that its underlying language has not been securely identified and read.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-linearb-salgarella"
      ],
      "source_locator": "gs-linearb-salgarella",
      "audit_status": "source_passage_checked"
    }
  ],
  "claim_evidence": [
    {
