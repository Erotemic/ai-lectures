  "historical_claims": [
    {
      "id": "snow-027-h01",
      "anchor": "On March 12, 1936, a snow crystal grew in a laboratory in northern Japan.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-nakaya-book",
        "gs-snow-nakaya-hokkaido"
      ],
      "source_locator": "gs-snow-nakaya-book",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h02",
      "anchor": "The filament was an unlikely piece of scientific equipment: a rabbit hair.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-nakaya-hokkaido"
      ],
      "source_locator": "gs-snow-nakaya-hokkaido",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h03",
      "anchor": "In 1611, Johannes Kepler published a short work called *The Six-Cornered Snowflake*.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-kepler-loc",
        "gs-snow-kepler-oxford"
      ],
      "source_locator": "gs-snow-kepler-loc",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h04",
      "anchor": "One of his ideas concerned the packing of little spherical particles.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-kepler-alaska"
      ],
      "source_locator": "gs-snow-kepler-alaska",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h05",
      "anchor": "In 1885 he obtained a successful photograph of an individual snow crystal.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-bentley-sia"
      ],
      "source_locator": "gs-snow-bentley-sia",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h06",
      "anchor": "Bentley went on to make more than five thousand snow-crystal photographs.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-bentley-sia"
      ],
      "source_locator": "gs-snow-bentley-sia",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h07",
      "anchor": "Bentley sometimes prepared or retouched the photographic negatives so the crystals would stand out against a black background.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-bentley-iowa"
      ],
      "source_locator": "gs-snow-bentley-iowa",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h08",
      "anchor": "Around five degrees below zero Celsius, snow crystals grown in moist conditions tend toward slender columns and needles.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-libbrecht-review"
      ],
      "source_locator": "gs-snow-libbrecht-review",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h09",
      "anchor": "Nakaya had begun studying natural snow crystals after moving into physics work at Hokkaido University in the early 1930s.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-nakaya-obit"
      ],
      "source_locator": "gs-snow-nakaya-obit",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h10",
      "anchor": "Then, on March 12, 1936, they obtained a crystal that resembled a natural six-branched snow crystal.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-snow-nakaya-book"
      ],
      "source_locator": "gs-snow-nakaya-book",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "snow-027-h11",
