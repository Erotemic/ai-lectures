      "audit_status": "source_passage_checked"
    },
    {
      "id": "lead-025-h04",
      "anchor": "the Centers for Disease Control and Prevention has used a blood lead reference value of three point five micrograms per deciliter for young children since 2021.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-lead-cdc-reference"
      ],
      "source_locator": "CDC MMWR 2021 reference value",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "lead-025-h05",
      "anchor": "In 1921, researchers at General Motors found that very small amounts of tetraethyl lead were remarkably effective at suppressing knock.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-lead-epa-history",
        "gs-lead-ornl-engines"
      ],
      "source_locator": "EPA and ORNL historical accounts",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "lead-025-h06",
      "anchor": "The additive reached the market in 1923 under the name Ethyl.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-lead-epa-history",
        "gs-lead-ornl-engines"
      ],
      "source_locator": "EPA and ORNL historical accounts",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "lead-025-h07",
      "anchor": "Workers manufacturing or handling it suffered serious poisoning, and employees died in industrial incidents during the 1920s.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-lead-epa-history"
      ],
      "source_locator": "EPA retrospective on production fatalities",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "lead-025-h08",
      "anchor": "His 1956 paper reported about four point five five billion years",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-lead-patterson-1956"
      ],
      "source_locator": "1956 journal abstract",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "lead-025-h09",
      "anchor": "His 1965 paper, Contaminated and Natural Lead Environments of Man, addressed that question.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-lead-patterson-1965"
      ],
      "source_locator": "1965 primary research article",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "lead-025-h10",
      "anchor": "completely phased out in the United States by the beginning of 1996.",
