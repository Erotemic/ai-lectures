      "source_ids": [
        "gs-lead-eia-gas"
      ],
      "source_locator": "EIA January 1 1996 phaseout",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "lead-025-h11",
      "anchor": "fifteen point two micrograms per deciliter in 1976 through 1980 to zero point eight three in 2011 through 2016.",
