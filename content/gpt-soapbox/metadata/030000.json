  "historical_claims": [
    {
      "id": "m030-h01",
      "anchor": "On the afternoon of April 26, 1803, people near the town of L'Aigle in Normandy heard a violent noise overhead.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-laigle-mnhn"
      ],
      "source_locator": "gs-stones-laigle-mnhn",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h02",
      "anchor": "The French government sent a young physicist, Jean-Baptiste Biot, to investigate.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-laigle-mnhn",
        "gs-stones-chladni-amnh"
      ],
      "source_locator": "gs-stones-laigle-mnhn",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h03",
      "anchor": "In November 1492, a large stone landed near Ensisheim, a town in Alsace.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-ensisheim-asu",
        "gs-stones-ensisheim-journal"
      ],
      "source_locator": "gs-stones-ensisheim-asu",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h04",
      "anchor": "In 1794, after searching through eyewitness accounts, he published an argument that masses of stone and iron really do fall from the sky.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-chladni-amnh"
      ],
      "source_locator": "gs-stones-chladni-amnh",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h05",
      "anchor": "The first asteroid, Ceres, would not be discovered until 1801.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-chladni-amnh"
      ],
      "source_locator": "gs-stones-chladni-amnh",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h06",
      "anchor": "On December 13, 1795, a stone fell in East Yorkshire, near Wold Newton.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-wold-nhm",
        "gs-stones-wold-asu"
      ],
      "source_locator": "gs-stones-wold-nhm",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h07",
      "anchor": "A farmworker named James Shipley was close enough to the impact to be struck by dirt thrown up from the ground.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-wold-nhm"
      ],
      "source_locator": "gs-stones-wold-nhm",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h08",
      "anchor": "The landowner, Edward Topham, took the event seriously.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-wold-nhm"
      ],
      "source_locator": "gs-stones-wold-nhm",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h09",
      "anchor": "In London, the chemist Edward Howard investigated alleged meteorites with the mineralogist Jacques-Louis de Bournon.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-chladni-amnh",
        "gs-stones-howard-royal"
      ],
      "source_locator": "gs-stones-chladni-amnh",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h10",
      "anchor": "Their work appeared in 1802, the year before the stones fell at L'Aigle.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-howard-royal",
        "gs-stones-chladni-amnh"
      ],
      "source_locator": "gs-stones-howard-royal",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h11",
      "anchor": "Jean-Baptiste Biot traveled from Paris to the country around L'Aigle in the summer of 1803.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-laigle-mnhn"
      ],
      "source_locator": "gs-stones-laigle-mnhn",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h12",
      "anchor": "He was twenty-nine years old.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-chladni-amnh",
        "gs-stones-laigle-mnhn"
      ],
      "source_locator": "gs-stones-chladni-amnh",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h13",
      "anchor": "The recovered fragments occupied an elongated region, about ten kilometers in length and four across in the reconstruction commonly cited today.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-chladni-amnh"
      ],
      "source_locator": "gs-stones-chladni-amnh",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h14",
      "anchor": "He presented his report in July.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-laigle-mnhn",
        "gs-stones-chladni-amnh"
      ],
      "source_locator": "gs-stones-laigle-mnhn",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h15",
      "anchor": "The fragments of L'Aigle are classified today as an ordinary chondrite, type L6.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-laigle-mnhn",
        "gs-stones-laigle-bulletin"
      ],
      "source_locator": "gs-stones-laigle-mnhn",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h16",
      "anchor": "The Paris museum's specimen record dates it to roughly 4.567 billion years.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-laigle-mnhn"
      ],
      "source_locator": "gs-stones-laigle-mnhn",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h17",
      "anchor": "In February 2021, a bright fireball crossed the sky over the United Kingdom.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-winchcombe-study",
        "gs-stones-winchcombe-nhm"
      ],
      "source_locator": "gs-stones-winchcombe-study",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h18",
      "anchor": "The following morning, residents of Winchcombe in Gloucestershire found dark fragments on their driveway.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-winchcombe-study",
        "gs-stones-winchcombe-nhm"
      ],
      "source_locator": "gs-stones-winchcombe-study",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h19",
      "anchor": "A spacecraft called OSIRIS-REx visited the asteroid Bennu.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-osiris-nasa"
      ],
      "source_locator": "gs-stones-osiris-nasa",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h20",
      "anchor": "It gathered material from Bennu's surface in October 2020 and returned a capsule to Earth in September 2023.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-osiris-nasa"
      ],
      "source_locator": "gs-stones-osiris-nasa",
      "audit_status": "source_passage_checked"
    },
    {
      "id": "m030-h21",
      "anchor": "In 2025, studies reported amino acids and the five nucleobases used in terrestrial genetic material.",
      "kind": "history_or_statistics",
      "source_ids": [
        "gs-stones-bennu-nasa"
      ],
      "source_locator": "gs-stones-bennu-nasa",
      "audit_status": "source_passage_checked"
    }
  ],
  "claim_evidence": [
    {
      "id": "m030-c01",
      "anchor": "A meteoroid is a natural piece of rock or metal traveling through space.",
      "source_ids": [
        "gs-stones-nasa-facts"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-stones-nasa-facts",
      "evidence_detail": "Modern naming distinction between source object, light and recovered material."
    },
    {
      "id": "m030-c02",
      "anchor": "A thin outer surface can resolidify into a dark fusion crust.",
      "source_ids": [
        "gs-stones-nasa-facts"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-stones-nasa-facts",
      "evidence_detail": "Outer-layer melting and ablation in atmospheric entry."
    },
    {
      "id": "m030-c03",
      "anchor": "The L refers to comparatively low total iron content within the ordinary chondrite families.",
      "source_ids": [
        "gs-stones-laigle-bulletin",
        "gs-stones-types-nhm"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-stones-laigle-bulletin",
      "evidence_detail": "Standard ordinary chondrite family nomenclature and heat metamorphism in type 6."
    },
    {
      "id": "m030-c04",
      "anchor": "Scientists therefore distinguish a meteorite 'fall' from a meteorite 'find.'",
      "source_ids": [
        "gs-stones-class-amnh"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-stones-class-amnh",
      "evidence_detail": "Classification of observed falls versus later finds."
    },
    {
      "id": "m030-c05",
      "anchor": "Dark meteorites stand out on pale ice in Antarctica, where the movements of glaciers can concentrate them in particular areas.",
      "source_ids": [
        "gs-stones-nasa-facts"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-stones-nasa-facts",
      "evidence_detail": "Antarctic meteorite field recovery and recognition."
    },
    {
      "id": "m030-c06",
      "anchor": "Researchers classified the rock as a carbonaceous chondrite.",
      "source_ids": [
        "gs-stones-winchcombe-study"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-stones-winchcombe-study",
      "evidence_detail": "Rapid analysis classifies Winchcombe as CM2 carbonaceous chondrite."
    },
    {
      "id": "m030-c07",
      "anchor": "These are ingredients of chemistry, not evidence that life existed on Bennu.",
      "source_ids": [
        "gs-stones-bennu-nasa"
      ],
      "provenance": "source_supported_explanation",
      "source_locator": "gs-stones-bennu-nasa",
      "evidence_detail": "Detected prebiotic molecules do not imply living organisms."
    }
  ],
  "description": "Reconstructs the 1803 L'Aigle meteorite fall and the evidence that helped make stones falling from space a credible scientific claim."
}
